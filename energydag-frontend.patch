+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>EnergyDAG</title>
+<style>
+:root{--bg:#f7f8fa;--card:#fff;--fg:#111827;--mut:#6b7280;--bd:#e5e7eb;--acc:#2563eb;--good:#16a34a;--bad:#dc2626}
+@media (prefers-color-scheme:dark){:root{--bg:#0f1115;--card:#171a21;--fg:#e5e7eb;--mut:#9ca3af;--bd:#2a2f3a;--acc:#60a5fa;--good:#4ade80;--bad:#f87171}}
+*{box-sizing:border-box}
+body{margin:0;background:var(--bg);color:var(--fg);font:14px/1.45 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
+header{padding:14px 24px;border-bottom:1px solid var(--bd);background:var(--card);display:flex;align-items:baseline;gap:16px;flex-wrap:wrap}
+header h1{margin:0;font-size:18px}header span{color:var(--mut)}
+nav{display:flex;gap:4px;margin-left:auto}
+nav button{background:none;border:1px solid transparent;color:var(--mut);padding:6px 12px;border-radius:6px;cursor:pointer;font:inherit}
+nav button.on{background:var(--bg);border-color:var(--bd);color:var(--fg)}
+main{max-width:1200px;margin:0 auto;padding:20px;display:grid;gap:16px}
+.card{background:var(--card);border:1px solid var(--bd);border-radius:10px;padding:16px}
+.card h2{margin:0 0 10px;font-size:14px;text-transform:uppercase;letter-spacing:.04em;color:var(--mut)}
+.controls{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;align-items:end}
+label{display:grid;gap:4px;font-size:12px;color:var(--mut)}
+select,input[type=number]{font:inherit;padding:6px 8px;border:1px solid var(--bd);border-radius:6px;background:var(--bg);color:var(--fg);width:100%}
+input[type=range]{width:100%}
+.btn{font:inherit;padding:8px 16px;border:0;border-radius:6px;background:var(--acc);color:#fff;cursor:pointer;font-weight:600}
+.btn:disabled{opacity:.5;cursor:wait}
+.chk{display:flex;gap:6px;align-items:center;color:var(--fg)}
+.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px}
+.stat{background:var(--bg);border:1px solid var(--bd);border-radius:8px;padding:10px 12px}
+.stat b{display:block;font-size:22px}.stat small{color:var(--mut)}
+.good{color:var(--good)}.bad{color:var(--bad)}
+.two{display:grid;grid-template-columns:1fr 1fr;gap:16px}@media(max-width:900px){.two{grid-template-columns:1fr}}
+.scroll{overflow:auto;max-height:420px;border:1px solid var(--bd);border-radius:8px;background:var(--bg)}
+svg text{fill:var(--mut);font:11px system-ui,sans-serif}
+.legend{display:flex;flex-wrap:wrap;gap:12px;margin-top:8px;color:var(--mut);font-size:12px}
+.legend i{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:4px;vertical-align:-1px}
+.legend i.ring{background:none;border:2px solid}
+table{border-collapse:collapse;width:100%}th,td{text-align:left;padding:5px 8px;border-bottom:1px solid var(--bd);font-size:13px}
+th{color:var(--mut);font-weight:500;position:sticky;top:0;background:var(--card)}
+.bar{height:7px;border-radius:3px;margin:2px 0}
+.msg{color:var(--mut);padding:8px 0}.err{color:var(--bad)}
+pre{white-space:pre-wrap;background:var(--bg);padding:10px;border-radius:8px;border:1px solid var(--bd);overflow:auto}
+.hidden{display:none}
+</style>
+</head>
+<body>
+<header>
+  <h1>EnergyDAG</h1><span>uncertainty-aware energy optimisation of ML task-graphs &middot; <b>simulated</b> platform</span>
+  <nav><button id="tab-run" class="on">Optimise</button><button id="tab-bench">Benchmarks</button></nav>
+</header>
+<main>
+<section id="view-run" style="display:contents">
+  <div class="card">
+    <h2>Run a search</h2>
+    <div class="controls">
+      <label>Model<select id="model"></select></label>
+      <label>Method<select id="method"></select></label>
+      <label>Measurement budget: <b id="budget-v">50</b><input id="budget" type="range" min="10" max="150" step="5" value="50"></label>
+      <label>Seed<input id="seed" type="number" value="0" min="0"></label>
+      <label>Accuracy tolerance (%)<input id="tol" type="number" value="1.0" step="0.1" min="0"></label>
+      <label>Latency slack (x default)<input id="slack" type="number" value="1.25" step="0.05" min="0.5"></label>
+      <label class="chk"><input id="oracle" type="checkbox"> compute oracle (slow)</label>
+      <button class="btn" id="run">Run</button>
+    </div>
+    <div id="status" class="msg"></div>
+  </div>
+
+  <div class="card"><h2>Result</h2><div id="stats" class="stats"><div class="msg">Run a search to see results.</div></div></div>
+
+  <div class="card">
+    <h2>Task graph &mdash; placement &amp; precision</h2>
+    <div class="scroll"><svg id="graph" height="120"></svg></div>
+    <div class="legend" id="graph-legend"></div>
+  </div>
+
+  <div class="two">
+    <div class="card"><h2>Convergence (best feasible energy vs measurements)</h2><svg id="conv" viewBox="0 0 640 300" width="100%"></svg><div class="legend" id="conv-legend"></div></div>
+    <div class="card"><h2>Counterfactual explanation</h2><div id="expl-note" class="msg"></div><div class="scroll" style="max-height:300px"><table id="expl"></table></div></div>
+  </div>
+
+  <div class="card"><h2>Plan details</h2><div class="scroll"><table id="plan"></table></div></div>
+</section>
+
+<section id="view-bench" class="hidden" style="display:none">
+  <div class="card">
+    <h2>Benchmarks (from results/results.csv)</h2>
+    <div class="controls" style="grid-template-columns:200px 1fr"><label>Model<select id="b-model"></select></label><span class="msg">Energy of the recommended plan divided by oracle energy (1.0 = oracle, lower is better; log scale).</span></div>
+    <svg id="bench" viewBox="0 0 640 340" width="100%"></svg><div class="legend" id="bench-legend"></div>
+    <div id="bench-msg" class="msg"></div>
+    <div class="scroll" style="max-height:none"><table id="bench-table"></table></div>
+  </div>
+  <div class="card" id="bench-md-card"><h2>summary.md</h2><pre id="bench-md"></pre></div>
+</section>
+</main>
+
+<script>
+const $ = s => document.querySelector(s);
+const DEV = ["cpu", "gpu", "npu"], PREC = ["fp32", "fp16", "int8"];
+const DEVCOL = ["#6b7280", "#16a34a", "#7c3aed"], PRECCOL = ["#94a3b8", "#f59e0b", "#ef4444"];
+const PALETTE = ["#2563eb", "#dc2626", "#16a34a", "#d97706", "#7c3aed", "#0891b2", "#db2777", "#4b5563", "#65a30d"];
+let META = null, GRAPH = {}, BENCH = null;
+const esc = s => String(s).replace(/[&<>"]/g, c => ({"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;"}[c]));
+const NS = "http://www.w3.org/2000/svg";
+function el(tag, attrs = {}, parent, text) {
+  const e = document.createElementNS(NS, tag);
+  for (const k in attrs) e.setAttribute(k, attrs[k]);
+  if (text !== undefined) e.textContent = text;
+  if (parent) parent.appendChild(e);
+  return e;
+}
+async function api(path, opts) {
+  const r = await fetch(path, opts);
+  const j = await r.json();
+  if (!r.ok) throw new Error(j.error || r.statusText);
+  return j;
+}
+
+/* ---------- generic line chart ---------- */
+function lineChart(svg, series, o = {}) {
+  svg.innerHTML = "";
+  const W = 640, H = o.h || 300, m = {l: 54, r: 14, t: 10, b: 36};
+  const pts = series.flatMap(s => s.pts).filter(p => p[1] != null && isFinite(p[1]));
+  if (!pts.length) return;
+  let x0 = Math.min(...pts.map(p => p[0])), x1 = Math.max(...pts.map(p => p[0]));
+  let y0 = Math.min(...pts.map(p => p[1])), y1 = Math.max(...pts.map(p => p[1]));
+  if (x0 === x1) x1 = x0 + 1;
+  if (y0 === y1) { y0 *= .9; y1 *= 1.1; }
+  if (!o.log) { const pad = (y1 - y0) * .08; y0 = Math.max(0, y0 - pad); y1 += pad; }
+  const fy = o.log ? Math.log : (v => v);
+  const sx = x => m.l + (x - x0) / (x1 - x0) * (W - m.l - m.r);
+  const sy = y => H - m.b - (fy(y) - fy(y0)) / (fy(y1) - fy(y0)) * (H - m.t - m.b);
+  for (let i = 0; i <= 4; i++) {
+    const yv = o.log ? Math.exp(fy(y0) + (fy(y1) - fy(y0)) * i / 4) : y0 + (y1 - y0) * i / 4;
+    el("line", {x1: m.l, x2: W - m.r, y1: sy(yv), y2: sy(yv), stroke: "currentColor", opacity: .12}, svg);
+    el("text", {x: m.l - 6, y: sy(yv) + 4, "text-anchor": "end"}, svg, yv.toFixed(2));
+    const xv = x0 + (x1 - x0) * i / 4;
+    el("text", {x: sx(xv), y: H - m.b + 16, "text-anchor": "middle"}, svg, Math.round(xv));
+  }
+  el("text", {x: (W + m.l) / 2, y: H - 4, "text-anchor": "middle"}, svg, o.xLabel || "");
+  el("text", {x: 12, y: H / 2, transform: `rotate(-90 12 ${H / 2})`, "text-anchor": "middle"}, svg, o.yLabel || "");
+  series.forEach((s, i) => {
+    const col = s.color || PALETTE[i % PALETTE.length];
+    const p = s.pts.filter(q => q[1] != null);
+    el("path", {d: p.map((q, k) => (k ? "L" : "M") + sx(q[0]) + " " + sy(q[1])).join(" "), fill: "none", stroke: col,
+      "stroke-width": s.dash ? 1.5 : 2, "stroke-dasharray": s.dash || ""}, svg);
+    if (p.length < 40) p.forEach(q => el("circle", {cx: sx(q[0]), cy: sy(q[1]), r: 3, fill: col}, svg));
+  });
+}
+function legend(div, series) {
+  div.innerHTML = series.map((s, i) => `<span><i style="background:${s.color || PALETTE[i % PALETTE.length]}"></i>${esc(s.name)}</span>`).join("");
+}
+
+/* ---------- DAG drawing ---------- */
+function drawGraph(g, run) {
+  const svg = $("#graph"); svg.innerHTML = "";
+  const n = g.ops.length, depth = new Array(n).fill(0);
+  g.ops.forEach((o, i) => o.preds.forEach(p => depth[i] = Math.max(depth[i], depth[p] + 1)));
+  const layers = {}, pos = [];
+  g.ops.forEach((o, i) => { (layers[depth[i]] = layers[depth[i]] || []).push(i); });
+  let maxL = 1;
+  for (const d in layers) { layers[d].forEach((i, k) => pos[i] = [28 + d * 32, 28 + k * 32]); maxL = Math.max(maxL, layers[d].length); }
+  const W = 56 + (Math.max(...depth) + 1) * 32, H = 56 + maxL * 32;
+  svg.setAttribute("width", W); svg.setAttribute("height", H); svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
+  const ops = run ? run.ops : null;
+  g.ops.forEach((o, i) => o.preds.forEach(p => {
+    let col = "#9ca3af", w = 1, op = .5;
+    if (ops) {
+      if (ops[p].group === ops[i].group) { col = "#2563eb"; w = 3.5; op = .9; }
+      else if (ops[p].dev !== ops[i].dev) { col = "#f97316"; w = 1.8; op = .9; }
+    }
+    el("line", {x1: pos[p][0], y1: pos[p][1], x2: pos[i][0], y2: pos[i][1], stroke: col, "stroke-width": w, opacity: op}, svg);
+  }));
+  g.ops.forEach((o, i) => {
+    const d = ops ? ops[i].dev : 0, pr = ops ? ops[i].prec : 0;
+    const c = el("circle", {cx: pos[i][0], cy: pos[i][1], r: ops && ops[i].fused ? 7 : 10,
+      fill: ops ? DEVCOL[d] : "#9ca3af", stroke: ops ? PRECCOL[pr] : "none", "stroke-width": 3}, svg);
+    el("title", {}, c, `${o.name} (${o.kind}, ${o.mflop.toFixed(1)} MFLOP)` + (ops ? ` -> ${DEV[d]}, ${PREC[pr]}${ops[i].fused ? ", fused" : ""}` : ""));
+  });
+  $("#graph-legend").innerHTML = ops
+    ? DEV.map((d, i) => `<span><i style="background:${DEVCOL[i]}"></i>${d}</span>`).join("") +
+      PREC.map((p, i) => `<span><i class="ring" style="border-color:${PRECCOL[i]}"></i>${p}</span>`).join("") +
+      `<span style="color:#2563eb">&#9644; fused edge</span><span style="color:#f97316">&#9644; cross-device transfer</span><span>small node = fused into predecessor</span>`
+    : "<span>Run a search to colour the graph by device / precision.</span>";
+}
+
+/* ---------- rendering of a run ---------- */
+function stat(label, value, sub, cls = "") { return `<div class="stat"><small>${label}</small><b class="${cls}">${value}</b><small>${sub || ""}</small></div>`; }
+function renderRun(r) {
+  const x = r.result;
+  const saved = (1 - x.E) * 100;
+  let html = stat("Energy vs default plan", (x.E * 100).toFixed(1) + "%", `${saved >= 0 ? saved.toFixed(0) + "% saved" : "worse than default"} &middot; ${x.energy_mJ.toFixed(1)} mJ`, saved > 0 ? "good" : "bad");
+  html += stat("Latency vs default", x.L.toFixed(2) + "x", `limit ${r.slack}x`, x.L <= r.slack * 1.02 ? "" : "bad");
+  html += stat("Accuracy drop (proxy)", x.acc.toFixed(2) + "%", `tolerance ${r.tol}%`, x.acc <= r.tol ? "" : "bad");
+  html += stat("Measurements used", r.measurements, `${r.elapsed_s.toFixed(1)} s search time`);
+  html += stat("Feasible", x.feasible ? "yes" : "no", x.feasible ? "" : "falls back to default plan", x.feasible ? "good" : "bad");
+  if (r.oracle) html += stat("Gap to oracle", (x.E / r.oracle.E).toFixed(2) + "x", `oracle = ${(r.oracle.E * 100).toFixed(1)}% of default`);
+  const s = r.summary;
+  html += stat("Plan shape", `${s.fused_groups} nodes`, `${s.ops} ops &middot; ${s.fused_edges} fusions &middot; cpu/gpu/npu = ${s.by_device.cpu}/${s.by_device.gpu}/${s.by_device.npu}`);
+  $("#stats").innerHTML = html;
+
+  drawGraph(GRAPH[r.model], r);
+
+  const series = [{name: "best feasible (measured, noisy)", pts: r.trace.map((v, i) => [i + 1, v])}];
+  if (r.oracle) series.push({name: "oracle", color: "#16a34a", dash: "5 4", pts: [[1, r.oracle.E], [Math.max(2, r.trace.length), r.oracle.E]]});
+  lineChart($("#conv"), series, {xLabel: "measurements", yLabel: "energy / default"});
+  legend($("#conv-legend"), series);
+
+  const rows = r.explanation, mx = Math.max(1e-9, ...rows.flatMap(q => [Math.abs(q.delta_mJ), Math.abs(q.true_delta_mJ)]));
+  const fid = r.fidelity && r.fidelity.pearson != null ? ` Fidelity vs simulator: Pearson ${r.fidelity.pearson.toFixed(2)}, Spearman ${r.fidelity.spearman.toFixed(2)} over ${r.fidelity.n} decisions.` : "";
+  $("#expl-note").innerHTML = `Revert one decision at a time to the stock default; negative = energy saved. Source: ${esc(r.explanation_source)}.${fid}`;
+  $("#expl").innerHTML = rows.length
+    ? "<tr><th>decision</th><th>predicted &Delta; mJ</th><th>true &Delta; mJ</th><th style='width:30%'></th></tr>" + rows.slice(0, 25).map(q => {
+      const w = v => Math.abs(v) / mx * 100;
+      return `<tr><td>${esc(q.decision)}</td><td>${q.delta_mJ.toFixed(2)}</td><td>${q.true_delta_mJ.toFixed(2)}</td><td>
+        <div class="bar" style="width:${w(q.delta_mJ)}%;background:${q.delta_mJ < 0 ? "var(--good)" : "var(--bad)"}"></div>
+        <div class="bar" style="width:${w(q.true_delta_mJ)}%;background:${q.true_delta_mJ < 0 ? "var(--good)" : "var(--bad)"};opacity:.45"></div></td></tr>`;
+    }).join("")
+    : "<tr><td class='msg'>No decisions: the plan equals the default.</td></tr>";
+
+  $("#plan").innerHTML = "<tr><th>#</th><th>op</th><th>kind</th><th>device</th><th>precision</th><th>fused into</th></tr>" +
+    r.ops.map(o => `<tr><td>${o.i}</td><td>${esc(o.name)}</td><td>${o.kind}</td><td>${DEV[o.dev]}</td><td>${PREC[o.prec]}</td><td>${o.fused ? esc(r.ops[o.group].name) : ""}</td></tr>`).join("");
+}
+
+/* ---------- benchmarks ---------- */
+function renderBench() {
+  if (!BENCH) return;
+  if (!BENCH.available) { $("#bench-msg").textContent = "No results/results.csv found. Run `make quick` (about 2 min) or `make full` first."; $("#bench-md-card").style.display = "none"; return; }
+  const sel = $("#b-model").value, data = sel === "__all" ? BENCH.overall : BENCH.by_model[sel];
+  const series = BENCH.methods.map(me => {
+    const v = data[me] || {};
+    return {name: me, pts: BENCH.budgets.map(b => [b, v[b] ?? v[0] ?? null]), dash: (v[0] != null && v[BENCH.budgets[0]] == null) ? "4 4" : ""};
+  });
+  lineChart($("#bench"), series, {log: true, h: 340, xLabel: "measurement budget", yLabel: "energy / oracle"});
+  legend($("#bench-legend"), series);
+  $("#bench-table").innerHTML = "<tr><th>method</th>" + BENCH.budgets.map(b => `<th>B=${b}</th>`).join("") + "</tr>" +
+    series.map(s => `<tr><td>${esc(s.name)}</td>${s.pts.map(p => `<td>${p[1] == null ? "" : p[1].toFixed(2)}</td>`).join("")}</tr>`).join("");
+  $("#bench-md").textContent = BENCH.summary_md || "";
+}
+
+/* ---------- wiring ---------- */
+function setTab(t) {
+  $("#view-run").style.display = t === "run" ? "contents" : "none";
+  $("#view-bench").style.display = t === "bench" ? "contents" : "none";
+  $("#tab-run").classList.toggle("on", t === "run"); $("#tab-bench").classList.toggle("on", t === "bench");
+  if (t === "bench" && !BENCH) api("/api/benchmarks").then(b => {
+    BENCH = b;
+    if (b.available) $("#b-model").innerHTML = '<option value="__all">All models (mean)</option>' + b.models.map(m => `<option>${m}</option>`).join("");
+    renderBench();
+  }).catch(e => $("#bench-msg").textContent = e.message);
+}
+async function showGraph() {
+  const m = $("#model").value;
+  if (!GRAPH[m]) GRAPH[m] = await api("/api/graph?model=" + encodeURIComponent(m));
+  drawGraph(GRAPH[m], null);
+}
+function syncBudget() {
+  $("#budget-v").textContent = $("#budget").value;
+  const free = META.budget_free.includes($("#method").value);
+  $("#budget").disabled = free;
+}
+async function init() {
+  META = await api("/api/meta");
+  $("#model").innerHTML = META.models.map(m => `<option value="${m.name}">${m.name} (${m.n_ops} ops)</option>`).join("");
+  $("#method").innerHTML = META.methods.map(m => `<option>${esc(m)}</option>`).join("");
+  $("#method").value = "active (ours)";
+  $("#tab-run").onclick = () => setTab("run"); $("#tab-bench").onclick = () => setTab("bench");
+  $("#b-model").onchange = renderBench;
+  $("#budget").oninput = syncBudget; $("#method").onchange = syncBudget; $("#model").onchange = showGraph;
+  syncBudget(); showGraph();
+  $("#run").onclick = async () => {
+    const btn = $("#run"), st = $("#status"), t0 = Date.now();
+    btn.disabled = true; st.className = "msg";
+    const tick = setInterval(() => st.textContent = `Running... ${((Date.now() - t0) / 1000).toFixed(0)} s (active search / oracle can take a while)`, 500);
+    try {
+      const r = await api("/api/run", {method: "POST", headers: {"Content-Type": "application/json"}, body: JSON.stringify({
+        model: $("#model").value, method: $("#method").value, budget: +$("#budget").value, seed: +$("#seed").value,
+        tol: +$("#tol").value, slack: +$("#slack").value, oracle: $("#oracle").checked})});
+      st.textContent = `Done in ${r.elapsed_s.toFixed(1)} s.`;
+      renderRun(r);
+    } catch (e) { st.className = "msg err"; st.textContent = "Error: " + e.message; }
+    finally { clearInterval(tick); btn.disabled = false; }
+  };
+}
+init().catch(e => { $("#status").className = "msg err"; $("#status").textContent = "Failed to load: " + e.message; });
+</script>
+</body>
+</html>
